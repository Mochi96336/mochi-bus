{
  "name": "mochi-bus",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mochi96336/mochi-bus.git"
  },
  "homepage": "https://bus.moc96336.com/",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare": "npm run instance:compile",
    "prebuild:map": "npm run instance:compile",
    "build:map": "vite build",
    "dev": "npm run build:map && wrangler dev",
    "deploy": "npm run build:map && wrangler deploy --minify",
    "release:smoke": "node scripts/release-smoke/run-post-deploy.mjs",
    "pretest": "npm run instance:compile",
    "test": "vitest run",
    "pretest:e2e": "npm run instance:compile",
    "test:e2e": "playwright test",
    "pretest:visual": "npm run instance:compile",
    "test:visual": "playwright test test/e2e/map-visual.spec.ts",
    "test:shape-pattern-measurement": "vitest run scripts/shape-pattern-measurement",
    "test:instance": "node --test scripts/instance/config.contract.mjs",
    "pretypecheck": "npm run instance:compile",
    "typecheck": "tsc --noEmit",
    "check": "npm run cf-typegen:check && npm run test && npm run test:instance && npm run typecheck && npm run build:map && wrangler deploy --dry-run",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --env-file .dev.vars.example",
    "cf-typegen:check": "wrangler types --env-interface CloudflareBindings --env-file .dev.vars.example --check",
    "instance:validate": "node scripts/instance/validate-config.mjs",
    "instance:compile": "node scripts/instance/compile-config.mjs",
    "measure:shape-pattern": "node scripts/shape-pattern-measurement/run.mjs",
    "verify:shape-pattern-report": "node scripts/shape-pattern-measurement/verify-report.mjs",
    "snapshot:city": "node scripts/sync-transit-snapshot.mjs",
    "snapshot:window": "node scripts/transit-snapshot/run-snapshot-window.mjs",
    "snapshot:watchdog": "node scripts/transit-snapshot/run-window-watchdog.mjs",
    "snapshot:public-probe": "node scripts/transit-snapshot/run-public-probe.mjs",
    "snapshot:repair-legacy-previous": "node scripts/transit-snapshot/repair-legacy-previous.mjs",
    "snapshot:rollback": "node scripts/transit-snapshot/rollback.mjs",
    "snapshot:reconcile": "node scripts/transit-snapshot/rollback.mjs reconcile"
  },
  "dependencies": {
    "hono": "^4.12.29",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@playwright/test": "^1.61.1",
    "@types/leaflet": "^1.9.21",
    "aws4fetch": "^1.0.20",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.4.0"
  }
}
